DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
PORT=3000

# Supabase Auth (required - the API refuses to start without these). From
# your Supabase project: Settings -> API -> Project URL / anon public key.
# The API verifies every request's bearer token against this project, so a
# caller can only ever act on accounts it actually owns.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Privy (signer vendor) -- see README "Signer vendor: Privy" for what's
# actually wired up. Never commit real values here.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Set to true to make /v1/execution/dry-run use real Hyperliquid hashing +
# real Privy signing instead of the offline fake scaffold. Still no venue
# submission either way. Requires an agent wallet already created via
# PrivyClient.createEthereumWallet().
ENABLE_REAL_SIGNER=false
PRIVY_AGENT_WALLET_ID=
PRIVY_AGENT_WALLET_ADDRESS=

# EVM-chain Safe provisioning (see packages/evm-guard, packages/evm) - off by default. When
# enabled, POST /v1/accounts deploys a real Safe (with GmxPositionLimitGuard already attached)
# for any request with venue="arbitrum-gmx" + evmOwnerWalletAddress + evmChainId=42161.
# EVM_ARBITRUM_ADMIN_PRIVATE_KEY pays gas for provisioning and never has signing authority over
# the resulting Safe (the trader's own evmOwnerWalletAddress is its sole owner) - never commit a
# real value here. EVM_ARBITRUM_SAFE_PROXY_FACTORY/SAFE_SINGLETON should be Safe's own canonical
# deployment addresses (re-verify against github.com/safe-global/safe-deployments before using in
# production); EVM_ARBITRUM_SAFE_GUARD_SETUP and EVM_ARBITRUM_GMX_GUARD_ADDRESS are MyPropGuard's
# own deployed packages/evm-guard contracts on Arbitrum (SafeGuardSetup.sol and
# GmxPositionLimitGuard.sol respectively) - neither is deployed anywhere yet, this is scaffolding
# for when they are.
ENABLE_EVM_ARBITRUM_PROVISIONING=false
EVM_ARBITRUM_RPC_URL=
EVM_ARBITRUM_ADMIN_PRIVATE_KEY=
EVM_ARBITRUM_SAFE_PROXY_FACTORY=
EVM_ARBITRUM_SAFE_SINGLETON=
EVM_ARBITRUM_SAFE_GUARD_SETUP=
EVM_ARBITRUM_GMX_GUARD_ADDRESS=

# Same pattern as Arbitrum above, for BSC (venue="bsc-pancakeswap", evmChainId=56) - MyPropGuard's
# own deployed PancakeSwapLimitGuard.sol address goes in EVM_BSC_PANCAKESWAP_GUARD_ADDRESS.
ENABLE_EVM_BSC_PROVISIONING=false
EVM_BSC_RPC_URL=
EVM_BSC_ADMIN_PRIVATE_KEY=
EVM_BSC_SAFE_PROXY_FACTORY=
# Use SafeL2 v1.4.1 (0x29fcB43b46531BcA003ddC8FCB67FFE91900C762) on BNB Chain: Safe{Wallet} refuses to execute
# transactions for Safes built on the standard singleton ("unsupported base contract").
EVM_BSC_SAFE_SINGLETON=
EVM_BSC_SAFE_GUARD_SETUP=
EVM_BSC_PANCAKESWAP_GUARD_ADDRESS=
# Moralis API key (free plan works). Finds the tokens a Safe holds so max-daily-loss counts everything
# the Safe bought; without it a buy can look like a loss. Run supabase/migrations/0009 first.
MORALIS_API_KEY=
# GoldRush (goldrush.dev) is preferred over Moralis when set; its free plan covers BNB Chain.
GOLDRUSH_API_KEY=
# Which service finds a Safe's tokens: safe (default, free, no key), goldrush, moralis, or none.
TOKEN_DISCOVERY_PROVIDER=safe

# Same pattern, for Ethereum mainnet (venue="ethereum-uniswap", evmChainId=1) - MyPropGuard's own
# deployed UniswapLimitGuard.sol address goes in EVM_ETHEREUM_UNISWAP_GUARD_ADDRESS.
ENABLE_EVM_ETHEREUM_PROVISIONING=false
EVM_ETHEREUM_RPC_URL=
EVM_ETHEREUM_ADMIN_PRIVATE_KEY=
EVM_ETHEREUM_SAFE_PROXY_FACTORY=
EVM_ETHEREUM_SAFE_SINGLETON=
EVM_ETHEREUM_SAFE_GUARD_SETUP=
EVM_ETHEREUM_UNISWAP_GUARD_ADDRESS=

# Hyperliquid watcher: watches a trader's own Hyperliquid account and, once a rule is broken, locks it for the
# UTC day and closes every new trade (existing positions are left alone). Off by default.
# HYPERLIQUID_NETWORK must be set explicitly (testnet or mainnet) so reads and orders share one network.
# HL_WATCHER_MODE=log only records what it would do; enforce really cancels orders and places reduce-only closes
# (needs ENABLE_REAL_SIGNER=true). Run migrations 0010 and 0011 first.
ENABLE_HL_WATCHER=false
HYPERLIQUID_NETWORK=
HL_WATCHER_MODE=log
HL_WATCHER_INTERVAL_MS=5000
HL_CLOSE_SLIPPAGE_BPS=500

# One-click trading on BSC: trade on the exchange's own site with no wallet popup. The server stays connected to the
# exchange over WalletConnect and signs each trade with the account's session key (a Privy wallet that the Guard
# lets trade and nothing else). Run migration 0012 first. Needs ENABLE_EVM_BSC_PROVISIONING=true, a Guard that
# supports session keys (redeploy SpotRiskGuard and point EVM_BSC_PANCAKESWAP_GUARD_ADDRESS at it), PRIVY_APP_ID
# and PRIVY_APP_SECRET, and a free WalletConnect project id from cloud.reown.com.
ENABLE_ONE_CLICK=false
WALLETCONNECT_PROJECT_ID=
# Public address of the dashboard, shown to exchanges as this wallet's website.
PUBLIC_WEB_URL=
# The wallet that pays gas for one-click trades (it has no power over anyone's funds). Defaults to the Guard
# admin wallet; keep a little BNB in it. Set this to use a separate wallet instead.
EVM_BSC_RELAYER_PRIVATE_KEY=
# Safe's MultiSendCallOnly v1.4.1 on BNB Chain; this default is the canonical address.
EVM_BSC_MULTISEND_CALL_ONLY=0x9641d764fc13c8B624c04430C7356C1C7C8102e2
