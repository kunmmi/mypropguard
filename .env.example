DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
PORT=3000

# Supabase Auth (required - the API refuses to start without these). From
# your Supabase project: Settings -> API -> Project URL / anon public key.
# The API verifies every request's bearer token against this project, so a
# caller can only ever act on accounts it actually owns.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Privy (signer vendor) -- see README "Signer vendor: Privy" for what's
# actually wired up. Never commit real values here.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Set to true to make /v1/execution/dry-run use real Hyperliquid hashing +
# real Privy signing instead of the offline fake scaffold. Still no venue
# submission either way. Requires an agent wallet already created via
# PrivyClient.createEthereumWallet().
ENABLE_REAL_SIGNER=false
PRIVY_AGENT_WALLET_ID=
PRIVY_AGENT_WALLET_ADDRESS=
