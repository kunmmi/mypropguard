# Same Supabase project as apps/api's SUPABASE_URL/SUPABASE_ANON_KEY (see
# ../../.env.example) - Settings -> API -> Project URL / anon public key.
# Required to build or run the dashboard; without these, sign-in/sign-up
# can't reach Supabase Auth at all.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the API server (apps/api) is listening.
NEXT_PUBLIC_API_URL=http://localhost:3000
